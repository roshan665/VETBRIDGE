# VETBRIDGE frontend environment configuration
#
# The frontend currently runs fully on mock data (VITE_USE_MOCK_API=true).
# When the FastAPI backend is ready:
#   1. set VITE_USE_MOCK_API=false
#   2. point VITE_API_BASE_URL to the FastAPI service (e.g. https://api.vetbridge.in/api/v1)
# No component code needs to change - all HTTP calls live in src/services/api.ts only.
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT_MS=15000
